WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL=5s
JOB_TIMEOUT=45m
RUNNING_JOB_TTL=50m

VIDEO_SUMMARY_BASE_URL=http://localhost:13000

# Optional mirror override when Docker Hub is rate-limited.
GO_IMAGE=golang:1.25-bookworm
PYTHON_IMAGE=python:3.12-slim

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

SUMMARY_MODE=http
SUMMARY_MODEL=chatgpt5.5

# Use either SUMMARY_* or ANTHROPIC_* names for OpenAI-compatible relay deployments.
SUMMARY_BASE_URL=
ANTHROPIC_BASE_URL=https://your-relay.example.com
